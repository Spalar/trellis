# Trellis Environment Configuration
# Copy this file to .env and fill in your values
# Or set these as environment variables in your shell

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Transport mode: stdio (default), http, or sse
TRELLIS_TRANSPORT=http

# Host for HTTP/SSE transport (default: 127.0.0.1)
TRELLIS_HOST=127.0.0.1

# Port for HTTP/SSE transport (default: 17317)
TRELLIS_PORT=17317

# API key for authenticated access (required for production)
# Set this to enable bearer token authentication
TRELLIS_API_KEY=your-secret-api-key-here

# Allow no-auth mode (set to true only for local development)
# When true, API key is not required
TRELLIS_ALLOW_NO_AUTH=true

# Data directory for graph storage (default: ~/.trellis)
# TRELLIS_DATA_DIR=~/.trellis

# =============================================================================
# AGENT RESPONSE GUARDS
# =============================================================================

# Max characters in a single MCP tool response (default: 50000).
# Oversized responses are rejected with a "response_too_large" error instead
# of being dumped into the agent's context window.
# TRELLIS_MAX_RESPONSE_CHARS=50000

# =============================================================================
# DIFF ANALYSIS (disabled by default)
# =============================================================================

# trellis_analyze_diff is NOT registered unless this is set to 1.
# Broad diffs run one impact analysis per changed function and time out.
# Prefer trellis_analyze_impact per changed function.
# TRELLIS_ENABLE_DIFF_ANALYSIS=0

# Hard caps applied when diff analysis is enabled:
# TRELLIS_MAX_DIFF_CHARS=200000
# TRELLIS_MAX_DIFF_FILES=50
# TRELLIS_MAX_DIFF_FUNCTIONS=25
