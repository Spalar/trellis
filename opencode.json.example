{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trellis-core": {
      "type": "local",
      "command": [
        "C:\\path\\to\\trellis\\.venv\\Scripts\\python.exe",
        "C:\\path\\to\\trellis\\server.py"
      ],
      "environment": {
        "TRELLIS_ALLOW_NO_AUTH": "true",
        "FASTMCP_SHOW_SERVER_BANNER": "false",
        "FASTMCP_LOG_LEVEL": "ERROR",
        "TRELLIS_DATA_DIR": "C:\\path\\to\\trellis\\.trellis\\data"
      },
      "enabled": true,
      "timeout": 10000
    }
  }
}
